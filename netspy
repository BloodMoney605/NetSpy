#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0")"
NETSPY_ROOT="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
export NETSPY_ROOT
export NETSPY_CONFIG="${NETSPY_CONFIG:-$NETSPY_ROOT/config/default.yaml}"
export PATH="$HOME/.local/bin:$HOME/go/bin:$PATH"

# colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
MAGENTA='\033[0;35m'
ORANGE='\033[0;38;5;208m'
WHITE='\033[1;37m'
NC='\033[0m'

# language
LANG="${NETSPY_LANG:-en}"

