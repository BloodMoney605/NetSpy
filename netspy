cmd_scan() {
    check_deps || exit 1
    local targets=""
    local config="$NETSPY_CONFIG"
    local output=""
    local threads=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --target) targets="$2"; shift 2 ;;
            --config) config="$2"; shift 2 ;;
            --output) output="$2"; shift 2 ;;
            --threads) threads="$2"; shift 2 ;;
            *)
                if [ -z "$targets" ]; then
                    targets="$1"
                elif [ -z "$threads" ]; then
                    threads="$1"
                fi
                shift
                ;;
        esac
    done
    if [ -z "$targets" ]; then
        phase_fail "--target is required"
        exit 1
    fi
    if [ -z "$output" ]; then
        output="$NETSPY_ROOT/output/target"
    fi
    mkdir -p "$output"
    local thread_args=()
    if [ -n "$threads" ]; then
        thread_args=(--threads "$threads")
    fi
    echo "$targets" > "$output/targets.txt"
    _run_py "$NETSPY_ROOT/lib/scan.py" --targets "$output/targets.txt" --config "$config" --output "$output" "${thread_args[@]}"
    phase_ok "scan data saved to $output/ports.json"
}

cmd_report() {
    local input=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --dir) input="$2"; shift 2 ;;
            *) if [ -z "$input" ]; then input="$1"; fi; shift ;;
        esac
    done
    if [ -z "$input" ]; then
        phase_fail "--dir is required"
        exit 1
    fi
    _run_py "$NETSPY_ROOT/lib/report.py" --input "$input" --output "$input"
    phase_ok "report saved to $input/report.txt"
}

# stealth helpers
stealth_opts=""
stealth_desc=""
stealth_choice=4
original_mac=""
spoofed_iface=""

cleanup_stealth() {
    if [ -n "$original_mac" ] && [ -n "$spoofed_iface" ]; then
        echo -e "\n  ${YELLOW}[!]${NC} restoring MAC on $spoofed_iface"
        sudo ip link set dev "$spoofed_iface" down 2>/dev/null && \
        sudo ip link set dev "$spoofed_iface" address "$original_mac" 2>/dev/null && \
        sudo ip link set dev "$spoofed_iface" up 2>/dev/null && \
        echo -e "  ${GREEN}[ok]${NC} MAC restored" || \
        echo -e "  ${YELLOW}[!]${NC} MAC restore failed"
        original_mac=""
        spoofed_iface=""
    fi
}

cleanup_and_exit() {
    cleanup_stealth
    echo -e "\n${DIM}Bye.${NC}"
    exit 0
}

_run_py() {
    python3 "$@"
    local rc=$?
    if [ $rc -eq 130 ]; then
        cleanup_and_exit
    fi
    return $rc
}

trap cleanup_and_exit INT TERM
trap cleanup_stealth EXIT

apply_stealth() {
    local choice="$1"
    stealth_opts=""
    stealth_desc=""
    case "$choice" in
        1)
            stealth_desc="MAC spoof + randomized delays + fake user-agent"
            export NETSPY_STEALTH=1
            ;;
        2)
            stealth_desc="Randomized delays + fake user-agent"
            export NETSPY_STEALTH=2
            ;;
        3)
            stealth_desc="MAC address spoof"
            export NETSPY_STEALTH=0
            ;;
        *)
            stealth_desc="none"
            export NETSPY_STEALTH=0
            ;;
    esac
}

t_stealth_title() {
    if [ "$LANG" = "es" ]; then
        echo -e "\n  ${BOLD}Configuracion de sigilo${NC}"
        echo -e "  ${DIM}Estas opciones ayudan a reducir tu huella durante el escaneo${NC}"
    else
        echo -e "\n  ${BOLD}Stealth configuration${NC}"
        echo -e "  ${DIM}These options help reduce your footprint during scanning${NC}"
    fi
}

t_stealth_item() {
    echo -e "    ${YELLOW}$1${NC}) $2"
}

t_stealth_prompt() {
    if [ "$LANG" = "es" ]; then
        echo -ne "\n  ${BOLD}Opcion${NC} [1-4]: "
    else
        echo -ne "\n  ${BOLD}Choice${NC} [1-4]: "
    fi
}

show_stealth_menu() {
    t_stealth_title
    if [ "$LANG" = "es" ]; then
        t_stealth_item "1" "Alto: spoof MAC + delays aleatorios + user-agent falso"
        t_stealth_item "2" "Medio: delays aleatorios + user-agent falso"
        t_stealth_item "3" "Bajo: spoof MAC address"
        t_stealth_item "4" "Ninguno (escaneo directo)"
    else
        t_stealth_item "1" "High: spoof MAC + random delays + fake user-agent"
        t_stealth_item "2" "Medium: random delays + fake user-agent"
        t_stealth_item "3" "Low: spoof MAC address"
        t_stealth_item "4" "None (direct scan)"
    fi
    t_stealth_prompt
    read -r stealth_choice || return 1
    apply_stealth "$stealth_choice"
}

spoof_mac() {
    local iface="${1:-$(ip route | grep default | awk '{print $5}' | head -1)}"
    if [ -z "$iface" ]; then
        echo -e "  ${YELLOW}[!]${NC} no network interface found, skipping MAC spoof"
        return
    fi
    original_mac="$(cat /sys/class/net/$iface/address 2>/dev/null)"
    if [ -z "$original_mac" ]; then
        echo -e "  ${YELLOW}[!]${NC} cannot read MAC for $iface, skipping"
        return
    fi
    spoofed_iface="$iface"
    local new_mac="02:$(openssl rand -hex 5 | sed 's/\(..\)/\1:/g; s/.$//')"
    echo -e "  ${YELLOW}[!]${NC} spoofing MAC on $iface: $original_mac -> $new_mac"
    sudo ip link set dev "$iface" down 2>/dev/null && \
    sudo ip link set dev "$iface" address "$new_mac" 2>/dev/null && \
    sudo ip link set dev "$iface" up 2>/dev/null && \
    echo -e "  ${GREEN}[ok]${NC} MAC changed" || \
    echo -e "  ${YELLOW}[!]${NC} MAC spoof failed (need sudo)"
}

# interactive menu
interactive_menu() {
    while true; do
        stealth_choice=4
        stealth_desc="none"
        original_mac=""
        spoofed_iface=""

        t_lang_prompt
        read -r lang_choice || exit 0
        case "$lang_choice" in
            2) LANG="es" ;;
            *) LANG="en" ;;
        esac
        export NETSPY_LANG="$LANG"

        show_stealth_menu || exit 0

        while true; do
            clear
            t_banner
            t_menu_title
            if [ "$LANG" = "es" ]; then
                t_menu_item "1" "Escaneo completo + reporte"
                t_menu_item "2" "Escaneo completo"
                t_menu_item "3" "Reconocimiento (solo subdominios/DNS)"
                t_menu_item "4" "Escaneo de puertos (IP/rango)"
                t_menu_item "5" "Generar reporte (datos existentes)"
                t_menu_item "6" "Instalar dependencias"
                t_menu_item "7" "Ver licencia"
                t_menu_item "q" "Salir"
                echo -e "\n  ${DIM}Sigilo: $stealth_desc${NC}"
            else
                t_menu_item "1" "Audit domain (full pipeline with report)"
                t_menu_item "2" "Scan domain (recon + scan + fingerprint + CVEs)"
                t_menu_item "3" "Reconnaissance (subdomains/DNS only)"
                t_menu_item "4" "Port scan (IP/range)"
                t_menu_item "5" "Generate report (existing data)"
                t_menu_item "6" "Install dependencies"
                t_menu_item "7" "View license"
                t_menu_item "q" "Quit"
                echo -e "\n  ${DIM}Stealth: $stealth_desc${NC}"
            fi
            t_prompt
            read -r choice || exit 0
            case "$choice" in
                1|2|3|4|5)
                    case "$stealth_choice" in
                        1|3) spoof_mac || true ;;
                    esac
                    ;;
            esac
            case "$choice" in
                1)
                    t_domain_prompt
                    read -r domain || exit 0
                    t_threads_prompt
                    read -r threads || exit 0
                    t_running
                    cmd_audit "$domain" "$threads"
                    ;;
                2)
                    t_domain_prompt
                    read -r domain || exit 0
                    t_threads_prompt
                    read -r threads || exit 0
                    t_running
                    cmd_scan_full "$domain" "$threads"
                    ;;
                3)
                    t_domain_prompt
                    read -r domain || exit 0
                    t_threads_prompt
                    read -r threads || exit 0
                    t_running
                    cmd_recon "$domain" "$threads"
                    ;;
                4)
                    t_target_prompt
                    read -r target || exit 0
                    t_threads_prompt
                    read -r threads || exit 0
                    t_running
                    cmd_scan "$target" "$threads"
                    ;;
                5)
                    t_dir_prompt
                    read -r dir || exit 0
                    t_running
                    cmd_report "$dir"
                    ;;
                6)
                    cmd_doctor
                    ;;
                7)
                    cat "$NETSPY_ROOT/LICENSE" 2>/dev/null || echo "License file not found."
                    ;;
                q|Q)
                    echo -e "\n${DIM}Bye.${NC}"
                    exit 0
                    ;;
                *)
                    continue
                    ;;
            esac
            t_back
            read -r
        done
    done
}

# CLI mode: netspy <command> [args]
if [ $# -gt 0 ]; then
    case "$1" in
        audit)  shift; cmd_audit "$@" ;;
        scan)   shift; cmd_scan_full "$@" ;;
        recon)  shift; cmd_recon "$@" ;;
        portscan) shift; cmd_scan "$@" ;;
        report) shift; cmd_report "$@" ;;
        doctor) cmd_doctor ;;
        license)
            cat "$NETSPY_ROOT/LICENSE" 2>/dev/null || echo "License file not found."
            ;;
        help|--help|-h)
            cat <<EOF
NetSpy — Network surveillance pipeline

Usage:
  netspy audit   --domain <domain>    Run full pipeline (phases 1-5)
  netspy scan    --domain <domain>    Scan domain (phases 1-4, no report)
  netspy recon   --domain <domain>    Phase 1: subdomain + dns recon only
  netspy portscan --target <ip/range> Phase 2: port scan only
  netspy report  --dir <output_dir>   Generate report from existing output
  netspy doctor                       Check and install dependencies
  netspy help                         Show this help
  netspy license                      Show license and disclaimer

Options:
  --domain       Target domain (ej: example.com)
  --target       IP address or CIDR range
  --config       Custom config file path
  --output       Output directory (default: ./output/<target>)
  --threads      Override thread count

Examples:
  netspy audit --domain ejemplo.com
  netspy scan --domain ejemplo.com
  netspy recon --domain ejemplo.com --threads 50
  netspy portscan --target 192.168.1.0/24 --output ./results
  netspy report --dir ./output/ejemplo.com
EOF
            ;;
        *) echo -e "${RED}[!] Unknown command: $1${NC}"; exit 1 ;;
    esac
else
    # interactive mode: netspy (no args)
    interactive_menu
fi
